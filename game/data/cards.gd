static func kind_of(card_name: String) -> String:
	var d: Dictionary = DEFS.get(card_name, {})
	return String(d.get("kind", ""))


static func weapon_range_of(card_name: String) -> int:
	var d: Dictionary = DEFS.get(card_name, {})
	return int(d.get("range", 1))


