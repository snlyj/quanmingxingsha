static func text_of(card_name: String) -> String:
	return String(TEXT.get(card_name, ""))


# 详细类型：基本牌 / 普通锦囊 / 延时锦囊 / 装备牌·武器 等
static func type_label_of(card_name: String) -> String:
	if card_name == "地契":
		return "装备牌 · 宝物（斗地主）"
	var k := kind_of(card_name)
	match k:
		"基本牌":
			return "基本牌"
		"锦囊牌":
			return "普通锦囊"
		"延时锦囊":
			return "延时锦囊"
		"武器":
			return "装备牌 · 武器"
		"防具":
			return "装备牌 · 防具"
		"饰品":
			return "装备牌 · 坐骑（%s）" % ("-1 进攻" if card_name == "疾行之靴" else "+1 防御")
		"宝物":
			return "装备牌 · 宝物"
	return k


static func yingbian_text(tags: Array) -> String:
	if tags.size() < 2:
		return ""
	var c := String(tags[0])
	var e := String(tags[1])
	return "应变【%s】→【%s】：%s时，%s。" % [c, e, String(YB_COND_TEXT.get(c, c)), String(YB_EFF_TEXT.get(e, e))]
